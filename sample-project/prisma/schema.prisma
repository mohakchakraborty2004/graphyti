datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

model User {
  id       Int     @id @default(autoincrement())
  contactEmail    String  @unique
  name     String?
  posts    Post[]
  password String
  username  String
  mobilePhone  String
  bio      String?
}

model Post {
  id        Int       @id @default(autoincrement())
  title     String?
  headline  String?
  heading   String?
  content   String?
  published Boolean   @default(false)
  status    String?   @default("DRAFT")
  priority  Int       @default(0)
  authorId  Int?
  author    User?     @relation(fields: [authorId], references: [id])
  comments  Comment[]
  summary  String?
  mobileNotes  String?
  reviewNotes  String?
  mobileSummary  String?
  summary  String?
  summary  String?
}

model Comment {
  id      Int     @id @default(autoincrement())
  caption String?
  body    String?
  content String?
  postId  Int
  post    Post    @relation(fields: [postId], references: [id])
}

